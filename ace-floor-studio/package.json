{
  "name": "ace-floor-studio",
  "productName": "Ace Floor Studio",
  "version": "1.1.0",
  "description": "The Media PA sales floor at a glance — every fixture on the blueprint, heat-colored by count currency, dead stock, on-hand accuracy, and more, straight from an Epicor Compass export.",
  "author": "Cody Suter",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "concurrently -k -n vite,electron -c magenta,green \"vite\" \"wait-on tcp:5175 && cross-env VITE_DEV_SERVER_URL=http://localhost:5175 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --port 4175 --strictPort",
    "test": "playwright test",
    "sample": "node scripts/make-sample.mjs",
    "icon": "node ../ace-studio-brand/icons.mjs floor",
    "dist:win": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.5",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.snydersace.floorstudio",
    "productName": "Ace Floor Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "AceFloorStudio.exe"
    }
  }
}
