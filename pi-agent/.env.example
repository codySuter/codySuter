# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Message @userinfobot on Telegram to find yours. If left empty the bot
# refuses everyone (and tells you your ID so you can add it here).
ALLOWED_USER_IDS=

# Ollama model to use. Must support tool calling.
# Good options on a Pi 5 / 16GB, fastest to smartest:
#   llama3.2:3b   - fast (~6 tok/s), decent
#   qwen3:4b      - good balance (default)
#   qwen2.5:7b    - smarter, slow (~2-3 tok/s)
OLLAMA_MODEL=qwen3:4b

# Where Ollama is listening (default is fine if it runs on the same Pi)
OLLAMA_HOST=http://127.0.0.1:11434

# --- Optional tuning ---
# Max search-tool round-trips per question before the model must answer
MAX_TOOL_ROUNDS=6
# Search results returned per web_search call
SEARCH_MAX_RESULTS=5
# Max characters of page text given to the model per fetch_page call
PAGE_CHAR_LIMIT=6000
# How many past exchanges to keep as chat context (keep small on a Pi)
HISTORY_TURNS=6
