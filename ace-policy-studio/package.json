{
  "name": "ace-policy-studio",
  "productName": "Ace Policy Studio",
  "version": "1.2.0",
  "description": "Design Snyder's Ace Hardware policy & procedure documents — drag-and-drop sections, brand fonts, one-page fit meter, print-ready PDF export.",
  "author": "Cody Suter",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "concurrently -k -n vite,electron -c magenta,green \"vite\" \"wait-on tcp:5173 && electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "playwright test",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/barlow-semi-condensed": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.snydersace.policystudio",
    "productName": "Ace Policy Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Ace Policy Studio",
      "artifactName": "AcePolicyStudio-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "codySuter",
        "repo": "codySuter",
        "releaseType": "release"
      }
    ]
  }
}
