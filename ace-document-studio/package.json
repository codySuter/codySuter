{
  "name": "ace-document-studio",
  "productName": "Ace Document Studio",
  "version": "2.3.0",
  "description": "Design Snyder's Ace Hardware store documents — policies, procedures, postings, agreements — with drag-and-drop sections, brand fonts, templates, revision history, and print-ready PDF/PNG export.",
  "author": "Cody Suter",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "concurrently -k -n vite,electron -c magenta,green \"vite\" \"wait-on tcp:5173 && electron .\"",
    "typecheck": "tsc --noEmit",
    "test:merge": "node scripts/sync-merge-test.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "playwright test",
    "icon": "node ../ace-studio-brand/icons.mjs document",
    "dist:win": "vite build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/barlow-semi-condensed": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.snydersace.documentstudio",
    "productName": "Ace Document Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "AceDocumentStudio-Setup.exe",
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "AceDocumentStudio.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/codysuter/codysuter/releases/download/ace-document-studio-windows"
      }
    ]
  }
}
