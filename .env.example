# --- Supabase ---------------------------------------------------------------
# Project URL and anon (public) key. Safe to expose to the browser.
# Find these in Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key. SERVER ONLY. Never prefixed with NEXT_PUBLIC, never sent to
# the browser. Used only inside trusted Server Actions (e.g. minting signed map
# URLs, admin tasks). Find it in the same API settings page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App --------------------------------------------------------------------
# The canonical URL of the deployed app. Used to build magic-link / invite
# redirect URLs. Locally this is http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
