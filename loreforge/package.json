{
  "name": "loreforge",
  "productName": "Loreforge",
  "version": "1.0.0",
  "description": "A Notion-style workspace for tabletop RPGs — D&D 5E (2024) and Daggerheart.",
  "author": "Cody Suter",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "setup": "npm install && npx convex dev --once",
    "dev": "concurrently -k -n convex,vite,electron -c blue,magenta,green \"npx convex dev\" \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:web": "concurrently -k -n convex,vite -c blue,magenta \"npx convex dev\" \"vite\"",
    "convex": "convex dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:mac:arm": "vite build && electron-builder --mac --arm64",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/cinzel": "^5.2.5",
    "@fontsource-variable/crimson-pro": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "clsx": "^2.1.1",
    "convex": "^1.42.1",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "convex-test": "^0.0.38",
    "cross-env": "^10.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.57.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.codysuter.loreforge",
    "productName": "Loreforge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Loreforge"
    }
  }
}
